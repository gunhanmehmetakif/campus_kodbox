# Copy to .env for local development. Validation: src/lib/env.ts
# (missing or invalid values fail on first use with a descriptive error).
# All values below are fake or public test values; never commit real secrets.

# PostgreSQL 16 (local: npm run db:up, host port 5433)
DATABASE_URL=postgres://kodbox:kodbox@localhost:5433/kodbox
# Separate database for integration tests (vitest); DB tests are skipped when unreachable
TEST_DATABASE_URL=postgres://kodbox:kodbox@localhost:5433/kodbox_test

# Public URL of the app (mail links, OAuth callback). No trailing slash.
APP_URL=http://localhost:3000
# Product name shown in the UI (inlined at build time)
NEXT_PUBLIC_APP_NAME=Kodbox Campus

# HMAC key for signed short-lived values. At least 32 characters.
#   generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# AES-256-GCM data encryption key (emails, student numbers, roster names). base64, 32 bytes.
#   generate: openssl rand -base64 32
# WARNING: changing it in production makes existing encrypted data unreadable.
DATA_ENCRYPTION_KEY=

# Blind index (HMAC-SHA256) key. base64, 32 bytes. Must differ from DATA_ENCRYPTION_KEY.
# WARNING: changing it requires recomputing every *_hash column.
BLIND_INDEX_KEY=

# Mail (Resend). When empty, mails are written to .dev-mail/ instead of being sent.
RESEND_API_KEY=
MAIL_FROM="Kodbox Campus <no-reply@kodbox.local>"

# Cloudflare Turnstile. Defaults are Cloudflare's always-pass TEST keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Skip server-side verification (development only; refused when NODE_ENV=production)
TURNSTILE_DEV_BYPASS=true

# Google sign-in (Arctic). When empty the button is hidden.
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push (F6). generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Shared secret for the cron endpoint (F6). Empty = endpoint disabled.
CRON_SECRET=

# npm run db:seed: first admin account (must be on the staff domain, e.g. mku.edu.tr).
# The admin must change this password on first login.
SEED_ADMIN_EMAIL=admin@mku.edu.tr
SEED_ADMIN_PASSWORD=
