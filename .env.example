# ─────────────────────────────────────────────────────────────────────────────
# Kodbox ortam değişkenleri. Yerelde bu dosyayı `.env.local` olarak kopyalayın.
# Doğrulama: src/lib/env.ts (eksik/yanlış değer ilk kullanımda açıklayıcı hata verir)
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL 16 (yerelde: docker compose up -d → host portu 5433)
DATABASE_URL=postgres://kodbox:kodbox@localhost:5433/kodbox
# Entegrasyon testleri (vitest) için ayrı veritabanı; boşsa DB testleri atlanır
TEST_DATABASE_URL=postgres://kodbox:kodbox@localhost:5433/kodbox_test

# Uygulamanın dışarıdan görünen kök adresi (mail linkleri, OAuth callback). Sonunda / olmadan.
APP_URL=http://localhost:3000

# İmzalı kısa ömürlü değerler (OAuth state çerezi vb.) için HMAC anahtarı. En az 32 karakter.
#   üret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# AES-256-GCM veri şifreleme anahtarı (e-posta, öğrenci no). base64, tam 32 byte.
#   üret: openssl rand -base64 32
# DİKKAT: Canlıda değiştirilirse mevcut şifreli veriler çözülemez (rotasyon için bkz. CONVENTIONS.md).
DATA_ENCRYPTION_KEY=

# Blind index (HMAC-SHA256) anahtarı. base64, tam 32 byte. DATA_ENCRYPTION_KEY'den FARKLI olmalı.
# DİKKAT: Değiştirilirse tüm *_hash sütunları yeniden hesaplanmalıdır.
BLIND_INDEX_KEY=

# Mail (Resend). Boşsa mailler gönderilmez; konsola ve .dev-mail/ klasörüne HTML olarak yazılır.
RESEND_API_KEY=
MAIL_FROM="Kodbox <no-reply@kodbox.com.tr>"

# Cloudflare Turnstile. Varsayılanlar Cloudflare'in "her zaman geçer" TEST anahtarlarıdır.
# Canlıda gerçek anahtarlarla değiştirin: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google ile giriş (Arctic). Boşsa buton gizlenir.
# Yetkili yönlendirme URI'si: {APP_URL}/giris/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple ile giriş — ücretli Apple Developer hesabı gerekir; hazır olana kadar kapalı.
FEATURE_APPLE_LOGIN=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 dosyasının içeriği (satır sonları \n olarak)
APPLE_PRIVATE_KEY=

# Zamanlanmış işler endpoint'i için paylaşılan gizli anahtar (F6). Boşsa cron endpoint'i kapalıdır.
CRON_SECRET=

# Seed (npm run db:seed) — ilk admin hesabı. Mail okulun personel domain'inde olmalı (mku.edu.tr).
ADMIN_EMAIL=admin@mku.edu.tr
ADMIN_PASSWORD=
